{
  "name": "wuji-extension",
  "private": true,
  "version": "3.8.0",
  "type": "module",
  "description": "无极 — 网页翻译、AI 对话、知识库、广告过滤 Chrome 扩展（UI 构建工程）",
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('ui/assets',{recursive:true,force:true})\"",
    "build": "vite build && vite build -c vite.panel.config.js",
    "build:panel": "vite build -c vite.panel.config.js",
    "watch": "vite build --watch",
    "watch:panel": "vite build -c vite.panel.config.js --watch"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7"
  }
}
